      "id": "4c179f14-b5bf-4609-a7de-841327ad6e6e",
      "name": "Sanitize Error Metadata",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        450,
        48
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const WORKFLOWS={\"f0dMmWk0Mte7utYu\":\"VILQA — клетчатка\",\"a08kQaFjSLUxlmpNlmV2J\":\"VILQA — бот\",\"ZRjTZf8Dejt-wZDny90_8\":\"VILQA — статистика\",\"9c44CeVZqqmXNebA\":\"VILQA — Mini App API\",\"J4XikahpZkt8KYXo\":\"ПРОВЕРКА мониторинга VILQA\"};\nconst EVENTS={\"model_output_invalid\":\"Ответ AI не прошёл проверку формата\",\"access_storage\":\"Не удалось проверить доступ к VILQA\",\"registration_storage\":\"Не удалось сохранить регистрацию\",\"meal_commit\":\"Не удалось подтвердить запись еды\",\"diary_storage\":\"Ошибка чтения или сохранения дневника\",\"voice_processing\":\"Не удалось обработать голосовое сообщение\",\"profile_notification_claim\":\"Не удалось подготовить уведомление об изменении профиля\",\"profile_notification_delivery\":\"Не удалось доставить уведомление об изменении профиля\",\"profile_notification_status\":\"Не удалось сохранить результат доставки уведомления\",\"meal_notification\":\"Не удалось отправить подтверждение записи еды\",\"meal_stats\":\"Не удалось отправить статистику после записи еды\"};\nfunction errorAlert(data) {\n  const id=String(data?.workflow?.id||data?.workflow_id||'');\n  if(!WORKFLOWS[id])return null;\n  const execution=data.execution||{};\n  const executionId=String(execution.id||data.execution_id||'');\n  const err=execution.error||data.trigger?.error||{};\n  const raw=String(err.message||'');\n  const category=/429|rate.?limit|too many requests/i.test(raw)?'Ограничение частоты запросов':/timeout|timed out|ETIMEDOUT/i.test(raw)?'Превышено время ожидания':/credential|unauthorized|forbidden|401|403/i.test(raw)?'Доступ или авторизация':/connect|database|postgres|ECONN/i.test(raw)?'Соединение или база данных':'Технический сбой';\n  const esc=v=>String(v).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');\n  const stage=String(execution.lastNodeExecuted||data.stage||data.trigger?.error?.node?.name||'Запуск workflow').slice(0,100);\n  const title=EVENTS[data.event]||'Workflow завершился с ошибкой';\n  const link=/^\\d{1,20}$/.test(executionId)?`https://n8n.svoidigital.ru/workflow/${id}/executions/${executionId}`:`https://n8n.svoidigital.ru/workflow/${id}`;\n  return {chat_id:180753266,text:`🚨 <b>${esc(title)}</b>\\n\\n${esc(WORKFLOWS[id])}\\nУзел: <code>${esc(stage)}</code>\\nТип: ${esc(category)}${executionId&&/^\\d{1,20}$/.test(executionId)?'\\nВыполнение: <code>'+executionId+'</code>':''}\\n\\n<a href=\"${link}\">Открыть в n8n</a>`,workflow_id:id,workflow_name:WORKFLOWS[id],error_message:title+' · '+category,last_node:stage,execution_url:link,mode:EVENTS[data.event]?'handled':'unhandled',execution_id:/^\\d{1,20}$/.test(executionId)?executionId:'',event:EVENTS[data.event]?data.event:'unhandled'};\n}\nconst result=errorAlert($input.first().json);return result?[{json:result}]:[];\r\n"
      }
