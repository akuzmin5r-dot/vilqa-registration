    {
      "id": "cd849539-bc36-404b-8e22-5203eb64e000",
      "name": "02 · Проверить кэш и состав",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        496,
        448
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function prepareFiber(job){\n if(!job||!Array.isArray(job.items)||job.items.length>30)throw Error('Invalid fiber job');\n const values=[],unknown=[];\n for(const item of job.items){\n  const base={id:Number(item.id),signature:item.signature};\n  if(typeof item.fiber==='number'&&Number.isFinite(item.fiber))values.push({...base,fiber:item.fiber});\n  else if(typeof item.cached_per100==='number'&&Number.isFinite(item.cached_per100)&&(item.recipe||!/(?:хлеб|батон|булоч|печенье|торт|колбас|сосиск|батончик)/i.test(item.name||'')))values.push({...base,fiber:Math.round(item.cached_per100*item.weight/100*10)/10});\n  else unknown.push({id:Number(item.id),name:item.name,weight:item.weight,calories:item.calories,protein:item.protein,fats:item.fats,carbs:item.carbs,recipe:item.recipe||null});\n }\n return {job,values,unknown,needs_model:unknown.length>0,prompt:JSON.stringify({items:unknown})};\n}\nreturn [{json:prepareFiber($input.first().json.job)}];"
      }
    },
    {
