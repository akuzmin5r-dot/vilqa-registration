        "query": "SELECT x AS op FROM vilqa.status_begin($1::bigint,$2,$3,$4) x;",
        "options": {
          "queryReplacement": "={{ [$json.user_id,$json.kind,$json.scope,$json.owner] }}",
          "largeNumbersOutput": "numbers"
