    {
      "id": "6501fc8b-2e62-444a-94e3-e42f56fecce3",
      "name": "Проверить команду статуса",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        288
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const x=$input.first().json,labels={food:'Думаю',stats:'Считаю статистику',recommendations:'Готовлю рекомендации',recipe:'Считаю рецепт',voice:'Распознаю голос',fiber:'Считаю клетчатку'};if(!['begin','end','animate','abort'].includes(x.phase)||!String(x.owner||'').match(/^[A-Za-z0-9_-]{1,80}$/))throw Error('Invalid status command');if(x.phase!=='abort'&&(!Number.isSafeInteger(Number(x.user_id))||Number(x.user_id)<=0||!labels[x.kind]))throw Error('Invalid status user or kind');return [{json:{phase:x.phase,user_id:Number(x.user_id)||0,kind:x.kind||'',owner:String(x.owner),scope:String(x.scope||'').slice(0,10000),payload:x.payload||{},label:labels[x.kind]||''}}];"
      }
    },
    {
      "id": "fc9a5104-5bc1-4392-bc22-e495230e487e",
      "name": "Выбрать действие",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.4,
      "position": [
        448,
        256
      ],
      "parameters": {
        "mode": "expression",
        "numberOutputs": 4,
        "output": "={{ ['begin','end','animate','abort'].indexOf($json.phase) }}"
      }
    },
    {
      "id": "7016a9b9-f1ab-42c0-ae71-35854f31cb14",
